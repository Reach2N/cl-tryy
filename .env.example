# Supabase Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key"

# Target referral URL base
# Default for Claude: "https://claude.ai/referral"
# For local Next.js test: "http://localhost:3000/referral"
BASE_URL="https://claude.ai/referral"

# Unique identifier for this machine/server (defaults to hostname if empty)
WORKER_ID="worker-1"

# Delay in seconds between requests on this server
REQUEST_INTERVAL="1.0"
